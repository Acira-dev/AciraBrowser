{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "noEmit": true, "types": ["vite/client", "node"]
  },
  // All of src/ and the TypeScript tests: files reached only through import.meta.glob (Settings panels) were never
  // checked before, which let a shadowed setColor call ship.
  "include": ["src", "tests", "vite.config.ts"],
  // Vendored Helium onboarding (Svelte) kept for GPL attribution only; it is not imported or built.
  "exclude": ["src/features/onboarding/upstream"]
}
