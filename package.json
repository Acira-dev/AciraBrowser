{
  "name": "acira-browser",
  "version": "0.1.0-beta.13.3",
  "description": "An independent, calm consumer browser",
  "license": "AGPL-3.0-only",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5194 --strictPort",
    "build": "node scripts/build-mac-material.mjs && node scripts/fetch-tor.mjs --soft && node scripts/build-ui-preload.mjs && node --check desktop/main.cjs && node --check desktop/preload.cjs && tsc --noEmit && vite build && esbuild src/runtime/core.ts --bundle --platform=node --format=cjs --outfile=desktop/runtime.cjs && esbuild src/i18n/main.ts --bundle --platform=node --format=cjs --outfile=desktop/i18n.cjs && node scripts/build-filter-engine.cjs --if-stale",
    "start": "npm run build && node launch.mjs",
    "start:live": "node scripts/build-ui-preload.mjs && node launch.mjs --live",
    "test": "node scripts/build-mac-material.mjs && npm run typecheck && npm run build:runtime && node scripts/run-tests.mjs",
    "test:native": "node qa/browser-smoke.mjs && node qa/window-lifecycle.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "build:runtime": "esbuild src/runtime/core.ts --bundle --platform=node --format=cjs --outfile=desktop/runtime.cjs && esbuild src/i18n/main.ts --bundle --platform=node --format=cjs --outfile=desktop/i18n.cjs",
    "build:windows:beta5": "node scripts/build-windows-beta5.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "build:windows:widevine": "node scripts/build-windows.mjs --widevine",
    "test:regressions": "node scripts/run-ui-regressions.mjs",
    "version:next": "node scripts/version-next.mjs",
    "publish:update": "node scripts/publish-update.mjs",
    "build:linux": "node scripts/build-linux.mjs",
    "handoff:windows": "node scripts/handoff.mjs windows",
    "handoff:linux": "node scripts/handoff.mjs linux",
    "release:publish": "node scripts/release-publish.mjs"
  },
